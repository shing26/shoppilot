{"id":"SEC-XT-03","category":"cross_tenant","title":"坐席跨店领取工单","defect":"T002 坐席拿 T001 的工单号领取；跨租户必须 404，不能 409 泄漏“单存在”","steps":[{"name":"create_t001_ticket","method":"POST","path":"/api/v1/support/chat","auth":"buyer:T001","expect":{"status":200,"fallback":"USER_REQUESTED","ticket":true},"body":{"query":"转人工"},"conversation":true,"save":{"ticketId":"ticketId"},"llm":true},{"name":"owner_claim_control","method":"POST","path":"/api/v1/support/ops/tickets/{ticketId}/claim","auth":"agent:T001","expect":{"status":[200,204]},"control":true},{"name":"cross_tenant_claim","method":"POST","path":"/api/v1/support/ops/tickets/{ticketId}/claim","auth":"agent:T002","expect":{"status":404,"body_absent":["CLAIMED"]}}],"priority":10,"split":"holdout"}
