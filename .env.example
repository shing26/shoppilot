# ShopPilot 环境变量样例。复制为 .env 并填入真实值；.env 已被 gitignore。
# 推荐：python scripts/bootstrap_env.py --force（把 replace-with-* 换成随机值；占位符会被启动守卫拒绝）。
# Docker Hub 401/限流时，容器档可指定镜像站基础镜像（不改 Dockerfile）：
# SHOPPILOT_MAVEN_IMAGE=docker.1ms.run/library/maven:3.9-eclipse-temurin-21
# SHOPPILOT_JRE_IMAGE=docker.1ms.run/library/eclipse-temurin:21-jre

# dev 模式：阿里云 DashScope 的 OpenAI 兼容端点（ADR 0012）
SHOPPILOT_LLM_API_KEY=sk-replace-me
SHOPPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SHOPPILOT_LLM_MODEL=qwen-plus
# round37：LLM 客户端模式。local = Ollama（本机默认），dev = 上面的 OpenAI 兼容端点，
# perf = 压测用固定输出 mock，demo = 容器产品演示的意图感知模板。
# 配了云端 key 却仍是 local 时，请求会全部打到 Ollama。确认 key 可用后再取消注释。
# SHOPPILOT_LLM_MODE=dev
# 对话演示可调到 0.6 左右去掉复读感；评测请保持默认 0.2，否则读数不可与历史比较。
# SHOPPILOT_LLM_TEMPERATURE=0.6
# 慢端点（含云端长回答、本地兼容服务）需要放宽；默认 20s。
# SHOPPILOT_LLM_READ_TIMEOUT=60s
# ADR 0012 的 dev 模式 token 日预算熔断，不设则用默认 200000。
# 完整评测集 180 条 ≈ 19 万 token，一轮就贴近默认值；跑评测当天按需提高，
# 而不是去改 application.yml。评测脚本会先报"剩余预算够不够本轮"再决定发不发请求。
# round35 票 149 起改成 600000：自主性评测集 part10 单跑 30 条 ≈ 29 万 token（票 140 实测），
# 600k = 一次全跑 + 一次复跑；闸门本体保留（ADR 0012 一字未改）。
# SHOPPILOT_LLM_DAILY_TOKEN_BUDGET=600000

# ADR 0008 的工具循环硬上限，round35 票 143 起默认 4（ADR 0069 §三）。不设就用默认值；
# 只有调档（压测、演示）才覆盖它——反思占同一条预算，改大等于同时放宽重试空间。
# SHOPPILOT_AGENT_MAX_TOOL_ROUNDS=4

# ADR 0014：mock JWT 签名密钥（HS256，至少 32 字节）
SHOPPILOT_JWT_SECRET=replace-with-32-bytes-minimum-secret

# ADR 0002 / ticket 15：网关与 biz-mock 之间的内部服务凭证，禁止下发给浏览器
SHOPPILOT_INTERNAL_TOKEN=replace-with-random-internal-token

# 中间件（与 docker-compose.yml 对齐；宿主端口为偏移值，避开 wslrelay 已占用的标准端口）
SHOPPILOT_REDIS_HOST=127.0.0.1
SHOPPILOT_REDIS_PORT=16379
SHOPPILOT_QDRANT_URL=http://127.0.0.1:16333
SHOPPILOT_ES_URL=http://127.0.0.1:19200

# 本地 embedding（ADR 0001：恒为 bge-m3，1024 维）
SHOPPILOT_OLLAMA_URL=http://127.0.0.1:11434
SHOPPILOT_EMBED_MODEL=bge-m3

# 服务端口（8080/8081/8090 在本机已被其它项目占用，ShopPilot 用 8082 / 8091）
SHOPPILOT_BIZMOCK_URL=http://127.0.0.1:8091

# ADR 0029 的运维凭证：运维面（故障注入 / 缓存清理 / 演示复位）。
# 回环绑定时不设也能起（吃仓库默认值 dev-ops-token），但非回环绑定必须覆盖或显式
# SHOPPILOT_OPS_ENABLED=false，否则拒绝启动——那条守护就是 ADR 0029。
SHOPPILOT_OPS_TOKEN=replace-with-random-ops-token

# round25 票 80 / ADR 0056：演示账号（buyer / agent / admin，每租户一套）的口令。
# **留空 = 不建任何演示账号**——这是仓库里没有默认口令的代价，也是它的好处。
# 正式登录面在网关的 /auth/login（票 81），那之前账号只用于演示与手工验证。
SHOPPILOT_IDENTITY_DEMO_PASSWORD=
# round37：产品页的「一键体验坐席 / 管理员」用同一份口令在服务端换令牌。
# 只在回环绑定上注册；留空时该端点 503，不创建也不猜测任何口令。

# round28 票 102 / ADR 0061：持久档（PostgreSQL）。容器档 full 必需——不给密码
# compose 会直接拒（:? 必需语法），这是「凭据不进仓库」的正确失败方式。
# 本机 JVM 想走持久档：SPRING_PROFILES_ACTIVE=postgres + 下面几行（默认档不配它们，行为不变）。
# round29 票 105 / ADR 0062 起按库用户隔离：biz-mock 用 bizmock_app、ticket 用 ticket_app
# （各自 yml 已默认，不用配）；口令两个角色共用一个，不要带单引号。
SHOPPILOT_DB_HOST=127.0.0.1
SHOPPILOT_DB_PORT=15432
SHOPPILOT_DB_PASSWORD=replace-with-random-db-password
# 持久档默认不播演示数据（5 万条压测订单不进真库）；要在持久档上演示就显式打开，
# SeedRunner 的「orders 非空即跳过」保证重启不翻倍。
# SHOPPILOT_BIZMOCK_DEMO_SEED=true

SHOPPILOT_IM_FEISHU_ENABLED=true
SHOPPILOT_IM_FEISHU_APP_ID=replace-with-feishu-app-id
SHOPPILOT_IM_FEISHU_APP_SECRET=replace-with-feishu-app-secret
# L1 单租户：一个飞书机器人绑定一个店铺/买家；多租户映射放 L2。
SHOPPILOT_IM_FEISHU_TENANT=T001
SHOPPILOT_IM_FEISHU_CUSTOMER=C001
