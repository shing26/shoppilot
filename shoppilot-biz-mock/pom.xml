<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.shoppilot</groupId>
    <artifactId>shoppilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shoppilot-biz-mock</artifactId>
  <name>shoppilot-biz-mock</name>
  <description>Mock 业务中台：独立进程、真 HTTP 边界（ADR 0002）</description>

  <properties>
    <shoppilot.jvm.max-ram-percentage>2</shoppilot.jvm.max-ram-percentage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.shoppilot</groupId>
      <artifactId>shoppilot-tool-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <!-- round23 票 71 / ADR 0054：审计事件流。**这是 biz-mock 第一次依赖 Redis**，
           所以做成软依赖——通道不可达时 AuditService 走直写落表兜底，
           退款放行这类资金动作不会因为审计发不出去而失败。 -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <!-- round18 票 42 / ADR 0041：模式的唯一产生源是 db/migration，ddl-auto 已是 validate。
           H2 支持在 flyway-core 内，不存在 flyway-database-h2 模块（已核实 Maven Central）。 -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- round25 票 80 / ADR 0056、0058：BCrypt 口令哈希。**只引这一个 artifact**，
           不引 spring-boot-starter-security——那会把一条完整的过滤链与「默认登录页」
           带进来，而本仓的身份入口是网关的 /auth/login，不是 Spring Security 的表单登录。
           版本由 spring-boot-dependencies 管，本仓不写死。 -->
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <jvmArguments>-XX:MaxRAMPercentage=${shoppilot.jvm.max-ram-percentage}</jvmArguments>
        </configuration>
        <executions>
          <execution>
            <!-- 产出可执行 fat jar，见 shoppilot-gateway/pom.xml 同处注释 -->
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
