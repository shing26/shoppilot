<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.shoppilot</groupId>
  <artifactId>shoppilot-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>ShopPilot</name>
  <description>面向电商大促的高并发智能客服与业务网关</description>

  <modules>
    <module>shoppilot-tool-api</module>
    <module>shoppilot-biz-mock</module>
    <module>shoppilot-gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.5</spring-boot.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <redisson.version>3.34.1</redisson.version>
    <jjwt.version>0.12.6</jjwt.version>
    <victools.version>4.35.0</victools.version>
    <archunit.version>1.3.0</archunit.version>
    <!-- round18 票 44 / ADR 0041：覆盖率工具。版本显式声明，与上面 surefire/compiler 同例，
         不依赖 BOM 是否替我们管这一支。 -->
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.shoppilot</groupId>
        <artifactId>shoppilot-tool-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <!-- round18 票 44 / ADR 0041：声明在 plugins 而不是 pluginManagement，三个模块一律继承。
         prepare-agent 默认绑 initialize、report 默认绑 verify，所以 mvnw verify 就会产出
         target/site/jacoco/jacoco.xml。棘轮不在这里判定——那件事归 scripts/check_coverage.py，
         它读产物按模块分别比门槛，见 ADR 0041 里「报告进构建 + 0 token 脚本判定」的口径。
         本仓 surefire 没有自定义 argLine，所以 prepare-agent 设的 argLine 属性不会被覆盖。 -->
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
