<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.shoppilot</groupId>
    <artifactId>shoppilot-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>shoppilot-ticket</artifactId>
  <name>shoppilot-ticket</name>
  <description>工单与坐席服务：统一工单实体、规则分流、坐席领取与 SLA（ADR 0053/0055，round23 票 72）</description>

  <properties>
    <shoppilot.jvm.max-ram-percentage>2</shoppilot.jvm.max-ram-percentage>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.shoppilot</groupId>
      <artifactId>shoppilot-tool-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 审计事件的生产端（ADR 0054/0056）：本服务发，坐席动作要留痕。消费与落表仍在
         biz-mock 侧（审计表归它），两个服务连同一条 Redis 流。
         **消费者缺席时事件只是被攒着，不会丢**——MAXLEN 之内都在。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <!-- 模式的唯一产生源是 db/migration，ddl-auto 已是 validate（ADR 0041）。 -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <!-- round28 票 100 / ADR 0061：Flyway 10 起数据库支持拆成独立模块，PG 的在这里；
           缺它就是「Unsupported Database: PostgreSQL 16.15」当场拒启（活体实测）。
           版本随 flyway-core 由 spring-boot-dependencies 管。 -->
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- round28 票 100 / ADR 0061：持久档（postgres profile）的驱动。默认档仍用 H2 内存库，
           版本由 spring-boot-dependencies 管。 -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <jvmArguments>-XX:MaxRAMPercentage=${shoppilot.jvm.max-ram-percentage}</jvmArguments>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>